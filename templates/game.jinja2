{% extends "layout.jinja2" %}
{% block body %}
    <h2>Mode: {{'Ties are counted' if data.mode == 'counted_ties' else "Play until someone's victory"}}<a class="button" href="{{url_for('init', mode=('counted_ties' if data.mode == 'until_victory' else 'until_victory'))}}">Switch mode</a></h3>
    {% set img_url = '' %}
    {% if 'character' not in data or data.character is none %}
        {% set img_url = 'images/character_choise.png' %}
    {% elif 'result' not in data or data.result is none %}
        {% set img_url = 'images/turn.png' %}
    {% elif data.result == 0 %}
        {% set img_url = 'images/tie.png' %}
    {% elif (data.result == 1 and data.character == 0) or (data.result == 2 and data.character == 1) %}
        {% set img_url = 'images/win_first.png' %}
    {% else %}
        {% set img_url = 'images/win_second.png' %}
    {% endif %}
    <img src="{{url_for('static', filename=img_url)}}" style="height: 30vh;">
    {% if 'character' in data and data.character is not none %}
        <h2>{{'Your turn!' if data.result is none else 'Tie!' if data.result == 0 else 'You won!' if data.result == 1 else 'You lost!'}} {% if data.result is not none %} <a class="button" href="{{url_for('continue_game')}}">{{'New round' if data.mode == 'until_victory' and data.result == 0 else 'Play one more time'}}</a> {% endif %}</h3>
        {% if data.mode == 'counted_ties' %}
            <h3>Ties: {{data.ties}}</h3>
        {% else %}
            {% set round = data.prev_round if 'prev_round' in data and data.prev_round is not none else data.round if data.result is not none else data.round + 1 %}
            <h3><span style="color: crimson;">Round {{round}}</span> | Max rounds number: {{data.max_round + 1}}</h3>
        {% endif %}
    {% else %}
        <h2>Select your character</h3>
    {% endif %}

    <div class="opponents-container" {% if 'character' not in data or data.character is none %} style="max-width: 45vh;" {% endif %}>
        {% for i in range(2) %}
            <div class="hands-container">
                {% if 'character' in data and data.character is not none %}
                    <h3>{{'Your' if data.character == i else "Opponent's"}} wins: {{data.wins[i]}}</h4>
                    <ul>
                        <li><a {% if data.character == i and data.result is none %} href="{{url_for('choise', choise=0)}}" {% endif %}><img src="{{url_for('static', filename='images/rock.png')}}" width="100" class="{{'hand-chosen' if data.result is not none and data.style_choises[i] == 0 else 'hand-disabled' if data.result is not none or i != data.character else 'hand-enabled'}}"></a></li>
                        <li><a {% if data.character == i and data.result is none %} href="{{url_for('choise', choise=1)}}" {% endif %}><img src="{{url_for('static', filename='images/paper.png')}}" width="100" class="{{'hand-chosen' if data.result is not none and data.style_choises[i] == 1 else 'hand-disabled' if data.result is not none or i != data.character else 'hand-enabled'}}"></a></li>
                        <li><a {% if data.character == i and data.result is none %} href="{{url_for('choise', choise=2)}}" {% endif %}><img src="{{url_for('static', filename='images/scissors.png')}}" width="100" class="{{'hand-chosen' if data.result is not none and data.style_choises[i] == 2 else 'hand-disabled' if data.result is not none or i != data.character else 'hand-enabled'}}"></a></li>
                    </ul>
                {% else %}
                    <a class="button" href="{{url_for('select_character', character=i)}}">↑</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {% if 'character' in data and data.character is not none %}
        <h2><a class="button" href="{{url_for('init', mode=data.mode)}}">Reset results</a></h2>
    {% endif %}
{% endblock %}